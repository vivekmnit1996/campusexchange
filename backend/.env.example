# CampusExchange Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave blank for automatic in-memory MongoDB in local dev)
MONGODB_URI=

# JWT Authentication Secrets
JWT_SECRET=campusexchange_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Frontend & AI Service URLs
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:5002/api/ai

# Cloudinary Image Hosting Configuration (Optional)
# If configured, images are uploaded directly to Cloudinary CDN (folder: campusexchange/products).
# If left blank, images are automatically stored locally in backend/uploads and served statically.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
